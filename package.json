{
  "name": "restosite",
  "private": true,
  "type": "module",
  "description": "Starter for TalloRes restaurant websites: Astro static site, deployed to a Cloudflare Worker.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && vitest run",
    "test": "vitest run",
    "verify": "tsx scripts/verify-dist.ts",
    "e2e": "playwright test",
    "translations:status": "tsx scripts/translations-status.ts",
    "deploy": "wrangler deploy",
    "templates:check": "tsx scripts/templates-check.ts",
    "demo:site": "tsx scripts/make-demo-site.ts"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "astro": "7.4.11",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
