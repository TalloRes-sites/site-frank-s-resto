---
// The TalloRes reservation widget. The page script resizes it on `tallores:resize` messages.
import type { Ctx } from '../lib/ctx';
interface Props { x: Ctx; frameStyle: string }
const { x, frameStyle } = Astro.props;
---
<div class="wframe" style={frameStyle}><iframe data-widget src={x.widgetSrc} title={x.L.reserveTable} loading="lazy"></iframe></div>
