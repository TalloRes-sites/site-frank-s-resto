---
// Click-to-load OpenStreetMap: nothing loads (no cookies, no requests) until the visitor clicks.
// Without coordinates nothing renders; templates always show the route button.
import type { Ctx } from '../lib/ctx';
interface Props { x: Ctx; boxStyle: string; buttonStyle: string; noteColor: string }
const { x, boxStyle, buttonStyle, noteColor } = Astro.props;
---
{x.mapSrc && (
  <div class="mapbox" style={boxStyle}>
    <span style={`font-size:14px;color:${noteColor}`}>{x.L.mapNote}</span>
    <button type="button" data-map={x.mapSrc} data-title={x.name} style={buttonStyle}>{x.L.showMap}</button>
  </div>
)}
