---
// Photo with alt text in the current language.
// Files from site/assets go through astro:assets (WebP, srcset); other URLs render as-is.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { localized } from '../lib/content';
import type { Ctx } from '../lib/ctx';
import type { Photo } from '../lib/types';

interface Props { x: Ctx; photo: Photo; eager?: boolean; sizes?: string }
const { x, photo, eager = false, sizes = '(max-width: 720px) 100vw, 50vw' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('@site/assets/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const key = photo.url.startsWith('/assets/') ? Object.keys(files).find((k) => k.endsWith(photo.url)) : undefined;
const alt = localized(x.c, photo.alt, x.lang);
---
{key
  ? <Image src={files[key].default} alt={alt} widths={[480, 960, 1600]} sizes={sizes} format="webp" quality={78} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  : <img src={photo.url} alt={alt} loading={eager ? undefined : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />}
