---
// One page per published language. The template is chosen at build time (astro.config.mjs → @template).
import Site from '@template';
import { buildCtx } from '../../lib/ctx';
import { loadSite } from '../../lib/site-data';
import type { Lang } from '../../lib/types';

export function getStaticPaths() {
  return loadSite().content.languages.map((lang) => ({ params: { lang } }));
}

const { restaurant, content } = loadSite();
const x = buildCtx(restaurant, content, Astro.params.lang as Lang);
---
<Site x={x} />
