---
// Template "Trattoria" (Italian, Mediterranean). Ported 1:1 from the hand-off render/trattoria.ts.
// Visual reference: docs/designs/site-trattoria-desktop.png
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/600.css';
import '@fontsource/nunito-sans/700.css';
import Document from '../../components/Document.astro';
import Img from '../../components/Img.astro';
import LangLinks from '../../components/LangLinks.astro';
import LangPicker from '../../components/LangPicker.astro';
import MapBox from '../../components/MapBox.astro';
import MobileBar from '../../components/MobileBar.astro';
import WidgetFrame from '../../components/WidgetFrame.astro';
import type { Ctx } from '../../lib/ctx';

interface Props { x: Ctx; today?: Date }
const { x, today } = Astro.props;
const c = x.pal; const L = x.L; const t = x.t;
const css = `
.tr-serif{font-family:'DM Serif Display',serif;font-weight:400}
.tr-h2{margin:0;font-size:clamp(36px,4.6cqi,56px);line-height:1.05}
.tr-hero{padding:56px 24px 80px}.tr-arches{display:flex}.tr-arch2{display:block}.tr-gal{grid-template-columns:repeat(4,minmax(0,1fr))}.tr-head{font-size:28px}
@container site (max-width:720px){.tr-hero{padding:32px 20px 48px}.tr-arch2{display:none}.tr-noph-m{display:none}.tr-gal{grid-template-columns:repeat(2,minmax(0,1fr))}.tr-head{font-size:21px}}`;
const btn = `height:54px;padding:0 28px;border-radius:27px;background:${c.accent};color:${c.on};font-weight:700;display:flex;align-items:center;text-decoration:none`;
const navLink = `color:${c.text};text-decoration:none`;

// Arches: photos when uploaded (hero first, then gallery), palette-coloured shapes otherwise.
const archPhotos = [x.gallery[0], x.hero, x.gallery[1]];
const archColors = [c.surface, c.accent, c.line];
const arches = [{ flex: '1 1 0', h: '320px' }, { flex: '1.3 1 0', h: '420px' }, { flex: '1 1 0', h: '320px' }].map((a, i) => ({
  ...a, photo: archPhotos[i], cls: `ph ${i === 1 ? '' : 'tr-arch2'}${archPhotos[i] ? '' : ' tr-noph-m'}`, color: archPhotos[i] ? c.surface : archColors[i], eager: i === 1,
}));
const DOC_ICON = ['M7 3h7l5 5v13H7z', 'M14 3v5h5M10 13h6M10 17h6'];
---
<Document x={x} css={css} today={today}>
<div class="site" style={`background:${c.bg};color:${c.text};font-family:'Nunito Sans',system-ui,sans-serif;font-size:17px;line-height:1.6`}>
  <header style={`position:sticky;top:0;z-index:5;background:${c.bg}`}>
    <div style="max-width:1200px;margin:0 auto;height:76px;padding:0 24px;display:flex;align-items:center;gap:32px">
      <a href="#top" class="ell tr-serif tr-head" style={`color:${c.text};text-decoration:none;flex:0 1 auto`}>{x.name}</a>
      <nav class="d-only" aria-label={L.navInfo} style="margin:0 auto;display:flex;gap:28px;font-weight:600;font-size:15px">
        {x.hasAbout && <a href="#over" style={navLink}>{t('aboutLabel') || L.navAbout}</a>}{x.menus.length > 0 && <a href="#menu" style={navLink}>{L.navMenu}</a>}<a href="#info" style={navLink}>{L.navInfo}</a>
      </nav>
      <div style="margin-left:auto;flex:0 0 auto;display:flex;align-items:center;gap:14px">
        <LangLinks x={x} linkStyle={`font-size:14px;font-weight:700;color:${c.muted};text-decoration:none`} currentStyle={`font-size:14px;font-weight:700;color:${c.text}`} />
        <a class="d-only" href="#reserveren" style={`height:46px;padding:0 22px;border-radius:23px;background:${c.accent};color:${c.on};font-weight:700;font-size:15px;display:flex;align-items:center;text-decoration:none`}>{L.reserve}</a>
        <LangPicker x={x} buttonStyle={`height:38px;padding:0 10px 0 12px;border:1px solid ${c.line};border-radius:19px;color:${c.text};font-size:14px;font-weight:600`} menuBg={c.card} text={c.text} />
      </div>
    </div>
  </header>
  <main>
    <section id="top" class="tr-hero" style="max-width:1200px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:28px;text-align:center">
      {t('overline') && <p class="tr-serif" style={`margin:0;font-style:italic;font-size:22px;color:${c.accentText}`}>{t('overline')}</p>}
      {t('tagline')
        ? <h1 class="tr-serif" style="margin:0;font-size:clamp(48px,8cqi,104px);line-height:1;max-width:900px">{t('tagline')}</h1>
        : <h1 class="sr-only">{x.name}</h1>}
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px">
        <a href="#reserveren" style={btn}>{L.reserveTable}</a>
        {x.vouchersUrl && <a href={x.vouchersUrl} style={`height:54px;padding:0 28px;border-radius:27px;border:2px solid ${c.accent};color:${c.accentText};font-weight:700;display:flex;align-items:center;text-decoration:none;box-sizing:border-box`}>{L.buyVoucher}</a>}
      </div>
      <div class="tr-arches" style="width:100%;gap:20px;align-items:flex-end;margin-top:20px">
        {arches.map((a) => <div class={a.cls} style={`flex:${a.flex};height:${a.h};border-radius:999px 999px 18px 18px;background:${a.color}`}>{a.photo && <Img x={x} photo={a.photo} eager={a.eager} sizes="(max-width: 720px) 100vw, 40vw" />}</div>)}
      </div>
    </section>

    {x.hasAbout && (
      <section id="over" style={`background:${c.surface}`}>
        <div style="max-width:1120px;margin:0 auto;padding:clamp(64px,9cqi,112px) 24px;display:flex;flex-wrap:wrap;gap:56px;align-items:center;justify-content:center">
          {x.about && <div class="ph" style={`flex:1 1 320px;aspect-ratio:4/5;max-height:520px;border-radius:999px 999px 24px 24px;background:${c.card}`}><Img x={x} photo={x.about} /></div>}
          <div style={`flex:1 1 380px;max-width:${x.about ? 'none' : '720px'};text-align:${x.about ? 'left' : 'center'};display:flex;flex-direction:column;gap:18px`}>
            {t('aboutLabel') && <p class="tr-serif" style={`margin:0;font-style:italic;font-size:22px;color:${c.accentText}`}>{t('aboutLabel')}</p>}
            {t('aboutTitle') && <h2 class="tr-serif tr-h2">{t('aboutTitle')}</h2>}
            {t('aboutText') && <div style={`color:${c.muted};white-space:pre-line`}>{t('aboutText')}</div>}
            {t('chef') && <p style="margin:0;font-weight:700">{t('chef')}</p>}
          </div>
        </div>
      </section>
    )}

    {x.menus.length > 0 && (
      <section id="menu" style="max-width:1120px;margin:0 auto;padding:clamp(64px,9cqi,112px) 24px;display:flex;flex-direction:column;align-items:center;gap:36px;text-align:center">
        <h2 class="tr-serif tr-h2">{t('menuTitle')}</h2>
        <div style="width:100%;display:flex;flex-wrap:wrap;gap:18px;justify-content:center">
          {x.menus.map((m) => (
            <a href={m.url} style={`flex:1 1 240px;max-width:340px;border-radius:22px;background:${c.card};border:1px solid ${c.line};padding:30px 24px;display:flex;flex-direction:column;align-items:center;gap:8px;color:${c.text};text-decoration:none`}>
              <span style={`width:52px;height:52px;border-radius:26px;background:${c.surface};display:flex;align-items:center;justify-content:center;color:${c.accentText}`}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">{DOC_ICON.map((d) => <path d={d} />)}</svg></span>
              <span class="tr-serif" style="font-size:26px">{m.name}</span><span style={`font-size:14px;color:${c.muted}`}>{m.note}</span><span style={`margin-top:6px;font-weight:700;color:${c.accentText}`}>{L.viewMenu}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {x.gallery.length > 2 && (
      <section aria-label={L.navAbout} class="tr-gal" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(64px,9cqi,112px);display:grid;gap:16px">
        {x.gallery.slice(2).map((p) => <div class="ph" style={`aspect-ratio:3/4;border-radius:18px;background:${c.surface}`}><Img x={x} photo={p} sizes="(max-width: 720px) 50vw, 25vw" /></div>)}
      </section>
    )}

    <section id="reserveren" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(64px,9cqi,112px)">
      <div style={`border-radius:32px;background:${c.surface};padding:clamp(28px,5cqi,64px);display:flex;flex-wrap:wrap;gap:40px;align-items:center`}>
        <div style="flex:1 1 320px;display:flex;flex-direction:column;gap:14px"><h2 class="tr-serif tr-h2">{t('reserveTitle')}</h2>{t('reserveIntro') && <p style={`margin:0;color:${c.muted}`}>{t('reserveIntro')}</p>}{x.groupLine && <p style={`margin:0;font-size:15px;color:${c.muted}`}>{x.groupLine}</p>}</div>
        <WidgetFrame x={x} frameStyle={`flex:1 1 360px;max-width:520px;border-radius:24px;overflow:hidden;background:${c.card}`} />
      </div>
    </section>

    <section id="info" style="max-width:1120px;margin:0 auto;padding:0 24px clamp(64px,9cqi,112px);display:flex;flex-wrap:wrap;gap:40px">
      <div style="flex:1 1 320px;display:flex;flex-direction:column;gap:10px">
        <h3 class="tr-serif" style="margin:0 0 6px;font-size:32px">{t('hoursTitle')}</h3>
        {x.hours.map((h) => <div data-day={h.day} style={`display:flex;justify-content:space-between;gap:16px;padding:8px 0;border-bottom:1px dashed ${c.line}`}><span>{h.label}</span><span style={`color:${h.closed ? c.muted : c.text}`}>{h.text}</span></div>)}
        {x.closures && <p style={`margin:6px 0 0;font-size:15px;font-weight:700;color:${c.accentText}`}>{x.closures}</p>}
      </div>
      <div id="contact" style="flex:1 1 320px;display:flex;flex-direction:column;gap:14px">
        <h3 class="tr-serif" style="margin:0 0 6px;font-size:32px">{t('locationTitle')}</h3>
        <MapBox x={x} boxStyle={`min-height:180px;border-radius:22px;background:${c.surface}`} buttonStyle={`height:40px;padding:0 16px;border-radius:20px;border:1px solid ${c.text};background:${c.card};color:${c.text};font:inherit;font-size:14px;font-weight:700;cursor:pointer`} noteColor={c.muted} />
        <address style="font-style:normal;display:flex;flex-direction:column;gap:6px"><span>{x.addressLine}, {x.cityLine}</span><span><a href={x.telHref} style={`color:${c.text}`}>{x.tel}</a> · <a href={`mailto:${x.email}`} style={`color:${c.text}`}>{x.email}</a></span></address>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <a href={x.routeHref} style={`height:44px;padding:0 18px;border-radius:22px;background:${c.text};color:${c.bg};font-weight:700;font-size:15px;display:flex;align-items:center;text-decoration:none`}>{L.route}</a>
          {x.socials.map((s) => <a href={s.href} rel="me" style={`height:44px;padding:0 18px;border-radius:22px;border:1px solid ${c.line};color:${c.text};font-weight:700;font-size:15px;display:flex;align-items:center;text-decoration:none`}>{s.label}</a>)}
        </div>
      </div>
    </section>

    {x.vouchersUrl && (
      <section id="cadeau" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(64px,9cqi,112px)">
        <div style={`border-radius:40px;background:${c.accent};color:${c.on};padding:28px 40px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between`}>
          <p class="tr-serif" style="margin:0;font-size:clamp(24px,2.8cqi,32px);line-height:1.2">{t('vouchersTitle')}</p><a href={x.vouchersUrl} style={`height:50px;padding:0 24px;border-radius:25px;background:${c.card};color:${c.text};font-weight:700;display:flex;align-items:center;text-decoration:none`}>{L.buyVoucher}</a>
        </div>
      </section>
    )}
  </main>
  <footer style={`border-top:1px solid ${c.line}`}>
    <div style={`max-width:1200px;margin:0 auto;padding:24px;display:flex;flex-wrap:wrap;gap:8px 24px;font-size:14px;color:${c.muted}`}>
      <span>{x.company}</span><a href="privacy/" style={`color:${c.muted}`}>{L.privacy}</a><span style="margin-left:auto">{L.madeBy}</span>
    </div>
  </footer>
  <MobileBar x={x} barStyle={`padding:10px 16px;background:${c.bg};border-top:1px solid ${c.line}`} buttonStyle={`flex:1;height:50px;border-radius:25px;background:${c.accent};color:${c.on};font-weight:700;display:flex;align-items:center;justify-content:center;text-decoration:none`} />
</div>
</Document>
