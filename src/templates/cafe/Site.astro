---
// Template "Café" (coffee, lunch, brunch). Ported 1:1 from the hand-off render/cafe.ts.
// Visual reference: docs/designs/site-cafe-desktop.png
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import Document from '../../components/Document.astro';
import Img from '../../components/Img.astro';
import LangLinks from '../../components/LangLinks.astro';
import LangPicker from '../../components/LangPicker.astro';
import MapBox from '../../components/MapBox.astro';
import MobileBar from '../../components/MobileBar.astro';
import WidgetFrame from '../../components/WidgetFrame.astro';
import type { Ctx } from '../../lib/ctx';

interface Props { x: Ctx; today?: Date }
const { x, today } = Astro.props;
const c = x.pal; const L = x.L; const t = x.t;
const css = `
.cf-serif{font-family:Fraunces,serif;font-weight:500}
.cf-h2{margin:0;font-size:clamp(36px,4.4cqi,54px);line-height:1.05}
.cf-bento{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}.cf-big{grid-column:span 3}.cf-side{grid-column:span 2}.cf-full{grid-column:span 5}
.cf-hero{min-height:520px}.cf-info{grid-template-columns:repeat(3,minmax(0,1fr))}.cf-gal{grid-template-columns:repeat(4,minmax(0,1fr))}.cf-head{font-size:23px}
@container site (max-width:720px){.cf-bento{grid-template-columns:1fr}.cf-big,.cf-side,.cf-full{grid-column:span 1}.cf-hero{min-height:380px}.cf-info{grid-template-columns:1fr}.cf-gal{grid-template-columns:repeat(2,minmax(0,1fr))}.cf-head{font-size:19px}}`;
const card = `border-radius:28px;background:${c.card};border:1px solid ${c.line}`;
const navLink = `color:${c.text};text-decoration:none`;
const DOC_ICON = ['M7 3h7l5 5v13H7z', 'M14 3v5h5M10 13h6M10 17h6'];
---
<Document x={x} css={css} today={today}>
<div class="site" style={`background:${c.bg};color:${c.text};font-family:Outfit,system-ui,sans-serif;font-size:17px;line-height:1.6;padding-bottom:1px`}>
  <header style="position:sticky;top:0;z-index:5;padding:14px 16px 0">
    <div style={`max-width:1180px;margin:0 auto;height:64px;padding:0 10px 0 22px;border-radius:32px;background:${c.card};border:1px solid ${c.line};display:flex;align-items:center;gap:28px`}>
      <a href="#top" class="ell cf-serif cf-head" style={`font-weight:600;color:${c.text};text-decoration:none;flex:0 1 auto`}>{x.name}</a>
      <nav class="d-only" aria-label={L.navInfo} style="display:flex;gap:24px;font-weight:500;font-size:15px">
        {x.menus.length > 0 && <a href="#menu" style={navLink}>{L.navMenu}</a>}{x.hasAbout && <a href="#over" style={navLink}>{L.navAbout}</a>}<a href="#info" style={navLink}>{L.navInfo}</a>
      </nav>
      <div style="margin-left:auto;flex:0 0 auto;display:flex;align-items:center;gap:12px">
        <LangLinks x={x} linkStyle={`font-size:14px;font-weight:600;color:${c.muted};text-decoration:none`} currentStyle={`font-size:14px;font-weight:600;color:${c.text}`} />
        <a class="d-only" href="#reserveren" style={`height:44px;padding:0 20px;border-radius:22px;background:${c.accent};color:${c.on};font-weight:600;font-size:15px;display:flex;align-items:center;text-decoration:none`}>{L.reserve}</a>
        <LangPicker x={x} buttonStyle={`height:38px;padding:0 10px 0 12px;border:1px solid ${c.line};border-radius:19px;color:${c.text};font-size:14px;font-weight:600`} menuBg={c.card} text={c.text} />
      </div>
    </div>
  </header>
  <main>
    <section id="top" class="cf-bento" style="max-width:1180px;margin:0 auto;padding:20px 16px 0">
      <div class="cf-big cf-hero" style={`border-radius:28px;background:${c.surface};padding:clamp(28px,4.5cqi,56px);display:flex;flex-direction:column;justify-content:flex-end;gap:20px`}>
        {t('overline') && <p style={`margin:0;font-size:15px;font-weight:600;color:${c.accentText}`}>{t('overline')}</p>}
        {t('tagline')
          ? <h1 class="cf-serif" style="margin:0;font-size:clamp(44px,6.6cqi,84px);line-height:1">{t('tagline')}</h1>
          : <h1 class="sr-only">{x.name}</h1>}
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <a href="#reserveren" style={`height:52px;padding:0 26px;border-radius:26px;background:${c.accent};color:${c.on};font-weight:600;display:flex;align-items:center;text-decoration:none`}>{L.reserveTable}</a>
          {x.vouchersUrl && <a href={x.vouchersUrl} style={`height:52px;padding:0 26px;border-radius:26px;background:${c.card};color:${c.text};font-weight:600;display:flex;align-items:center;text-decoration:none`}>{L.buyVoucher}</a>}
        </div>
      </div>
      <div class="cf-side" style="display:flex;flex-direction:column;gap:16px">
        {x.hero
          ? <div class="ph" style={`flex:1 1 auto;min-height:260px;border-radius:28px;background:${c.surface}`}><Img x={x} photo={x.hero} eager /></div>
          : <div aria-hidden="true" style={`flex:1 1 auto;min-height:260px;${card};display:flex;align-items:center;justify-content:center`}><span class="cf-serif" style={`font-size:180px;line-height:1;color:${c.accentText}`}>{x.initial}</span></div>}
        <div data-today-wrap hidden style={`border-radius:28px;background:${c.accent};color:${c.on};padding:22px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px`}>
          <span style="display:flex;flex-direction:column"><span style="font-size:14px;opacity:.9">{L.today}</span><span data-today-until class="cf-serif" style="font-size:24px;font-weight:600"></span></span>
          <a href="#info" style={`color:${c.on};font-weight:600;font-size:15px`}>{L.allHours}</a>
        </div>
      </div>
    </section>

    {x.hasAbout && (
      <section id="over" class="cf-bento" style="max-width:1180px;margin:0 auto;padding:16px 16px 0">
        {x.about && <div class="ph cf-side" style={`min-height:300px;border-radius:28px;background:${c.surface}`}><Img x={x} photo={x.about} sizes="(max-width: 720px) 100vw, 40vw" /></div>}
        <div class={x.about ? 'cf-big' : 'cf-full'} style={`${card};padding:clamp(28px,4cqi,48px);display:flex;flex-direction:column;justify-content:center;gap:14px`}>
          {t('aboutTitle') && <h2 class="cf-serif" style="margin:0;font-size:clamp(32px,3.8cqi,46px);line-height:1.1">{t('aboutTitle')}</h2>}
          {t('aboutText') && <div style={`color:${c.muted};white-space:pre-line`}>{t('aboutText')}</div>}{t('chef') && <p style="margin:0;font-weight:600">{t('chef')}</p>}
        </div>
      </section>
    )}

    {x.menus.length > 0 && (
      <section id="menu" style="max-width:1180px;margin:0 auto;padding:clamp(56px,7cqi,88px) 16px 0;display:flex;flex-direction:column;gap:24px">
        <h2 class="cf-serif cf-h2" style="margin:0 8px">{t('menuTitle')}</h2>
        <div style="display:flex;flex-wrap:wrap;gap:16px">
          {x.menus.map((m) => (
            <a href={m.url} style={`flex:1 1 240px;border-radius:24px;background:${c.card};border:1px solid ${c.line};padding:24px;display:flex;align-items:center;gap:16px;color:${c.text};text-decoration:none`}>
              <span style={`width:52px;height:52px;flex:0 0 52px;border-radius:16px;background:${c.surface};color:${c.accentText};display:flex;align-items:center;justify-content:center`}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">{DOC_ICON.map((d) => <path d={d} />)}</svg></span>
              <span style="display:flex;flex-direction:column;flex:1;min-width:0"><span class="cf-serif" style="font-size:22px;font-weight:600">{m.name}</span><span style={`font-size:14px;color:${c.muted}`}>{m.note}</span></span><span aria-hidden="true" style={`font-size:20px;color:${c.accentText}`}>→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {x.gallery.length > 0 && (
      <section aria-label={L.navAbout} class="cf-gal" style="max-width:1180px;margin:0 auto;padding:16px 16px 0;display:grid;gap:16px">
        {x.gallery.map((p) => <div class="ph" style={`aspect-ratio:1;border-radius:24px;background:${c.surface}`}><Img x={x} photo={p} sizes="(max-width: 720px) 50vw, 25vw" /></div>)}
      </section>
    )}

    <section id="reserveren" style="max-width:1180px;margin:0 auto;padding:clamp(56px,7cqi,88px) 16px 0">
      <div style={`border-radius:32px;background:${c.surface};padding:clamp(24px,4.5cqi,56px);display:flex;flex-wrap:wrap;gap:32px;align-items:center`}>
        <div style="flex:1 1 300px;display:flex;flex-direction:column;gap:12px"><h2 class="cf-serif cf-h2">{t('reserveTitle')}</h2>{t('reserveIntro') && <p style={`margin:0;color:${c.muted}`}>{t('reserveIntro')}</p>}{x.groupLine && <p style={`margin:0;font-size:15px;color:${c.muted}`}>{x.groupLine}</p>}</div>
        <WidgetFrame x={x} frameStyle={`flex:1 1 360px;max-width:520px;border-radius:24px;overflow:hidden;background:${c.card}`} />
      </div>
    </section>

    <section id="info" class="cf-info" style="max-width:1180px;margin:0 auto;padding:16px 16px 0;display:grid;gap:16px">
      <div style={`${card};padding:26px;display:flex;flex-direction:column;gap:8px`}>
        <h3 class="cf-serif" style="margin:0 0 6px;font-weight:600;font-size:24px">{t('hoursTitle')}</h3>
        {x.hours.map((h) => <div data-day={h.day} style="display:flex;justify-content:space-between;gap:12px;font-size:16px"><span>{h.label}</span><span style={`color:${h.closed ? c.muted : c.text}`}>{h.text}</span></div>)}
        {x.closures && <p style={`margin:8px 0 0;font-size:14px;padding:8px 12px;border-radius:12px;background:${c.surface}`}>{x.closures}</p>}
      </div>
      <div id="contact" style={`${card};padding:26px;display:flex;flex-direction:column;gap:10px`}>
        <h3 class="cf-serif" style="margin:0 0 6px;font-weight:600;font-size:24px">{t('locationTitle')}</h3>
        <address style="font-style:normal;display:flex;flex-direction:column;gap:6px"><span>{x.addressLine}, {x.cityLine}</span><a href={x.telHref} style={`color:${c.text}`}>{x.tel}</a><a href={`mailto:${x.email}`} style={`color:${c.text}`}>{x.email}</a></address>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">
          <a href={x.routeHref} style={`height:42px;padding:0 16px;border-radius:21px;background:${c.accent};color:${c.on};font-weight:600;font-size:15px;display:flex;align-items:center;text-decoration:none`}>{L.route}</a>
          {x.socials.map((s) => <a href={s.href} rel="me" style={`height:42px;padding:0 16px;border-radius:21px;background:${c.surface};color:${c.text};font-weight:600;font-size:15px;display:flex;align-items:center;text-decoration:none`}>{s.label}</a>)}
        </div>
      </div>
      <MapBox x={x} boxStyle={`min-height:240px;border-radius:28px;background:${c.surface}`} buttonStyle={`height:40px;padding:0 16px;border-radius:20px;border:0;background:${c.card};color:${c.text};font:inherit;font-size:14px;font-weight:600;cursor:pointer`} noteColor={c.muted} />
    </section>

    {x.vouchersUrl && (
      <section id="cadeau" style="max-width:1180px;margin:0 auto;padding:16px 16px 0">
        <div style={`border-radius:28px;background:${c.accent};color:${c.on};padding:30px 32px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between`}>
          <p class="cf-serif" style="margin:0;font-size:clamp(24px,2.8cqi,32px);line-height:1.2">{t('vouchersTitle')}</p><a href={x.vouchersUrl} style={`height:50px;padding:0 24px;border-radius:25px;background:${c.card};color:${c.text};font-weight:600;display:flex;align-items:center;text-decoration:none`}>{L.buyVoucher}</a>
        </div>
      </section>
    )}
  </main>
  <footer style={`max-width:1180px;margin:48px auto 0;padding:20px 24px;display:flex;flex-wrap:wrap;gap:8px 24px;font-size:14px;color:${c.muted}`}>
    <span>{x.company}</span><a href="privacy/" style={`color:${c.muted}`}>{L.privacy}</a><span style="margin-left:auto">{L.madeBy}</span>
  </footer>
  <MobileBar x={x} barStyle={`padding:10px 16px;background:${c.bg}`} buttonStyle={`flex:1;height:50px;border-radius:25px;background:${c.accent};color:${c.on};font-weight:600;display:flex;align-items:center;justify-content:center;text-decoration:none`} />
</div>
</Document>
