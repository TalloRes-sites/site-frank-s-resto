{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".tmp"
  ],
  "compilerOptions": {
    "paths": {
      "@template": [
        "./src/templates/klassiek/Site.astro"
      ],
      "@site/*": [
        "./site/*"
      ]
    }
  }
}
